{
  "productName": "Nidus",
  "version": "0.1.0",
  "identifier": "eu.tdelab.nidus",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "title": "Nidus Dashboard",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/nidus"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
